# Google Cloud — abilita Places API (New) e PageSpeed Insights API
GOOGLE_MAPS_API_KEY=

# Supabase — progetto Postgres
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — generazione mail e mini-audit
ANTHROPIC_API_KEY=

# Password di accesso all'app. Obbligatoria: se assente, l'app resta chiusa.
RADAR_PASSWORD=

# Account Gmail mittente per l'azione "Apri in Gmail" (opzionale)
NEXT_PUBLIC_GMAIL_ACCOUNT=
